          "  <div class='absolute left-0 right-0 text-center text-5xl font-semibold text-slate-100' style='top:84px'>It all lives behind the gear.</div>",
          "  <div class='absolute' style='top:180px;left:110px;width:1060px'>",
          "    <video src='./settings-you-can-find-assets/00-where-it-lives.mp4' autoplay muted playsinline class='rounded-xl shadow-2xl' style='width:1060px;display:block'></video>",
          "  </div>",
          "</div>"
        ]
