{
  "$mulmocast": {
    "version": "1.1"
  },
  "canvasSize": {
    "width": 1280,
    "height": 720
  },
  "imageParams": {
    "provider": "openai",
    "images": {},
    "concurrency": 1
  },
  "audioParams": {
    "bgm": {
      "kind": "path",
      "path": "../../resources/bgms/morning001.mp3"
    },
    "padding": 0.3,
    "introPadding": 0.5,
    "closingPadding": 0.3,
    "outroPadding": 2.5,
    "bgmVolume": 0.12,
    "audioVolume": 1,
    "suppressSpeech": false,
    "concurrency": 1
  },
  "lang": "en",
  "speechParams": {
    "speakers": {
      "Presenter": {
        "displayName": {
          "en": "Presenter"
        },
        "voiceId": "Kore",
        "isDefault": true,
        "provider": "gemini",
        "speechOptions": {
          "instruction": "Calm, confident, measured — short declarative sentences, like a good product keynote. No exclamation marks in delivery, no salesy energy. Let the pauses between sentences breathe."
        }
      }
    }
  },
  "captionParams": {
    "lang": "en",
    "captionSplit": "estimate",
    "textSplit": {
      "type": "delimiters",
      "delimiters": [
        ". "
      ]
    },
    "bottomOffset": 4
  },
  "title": "MulmoTerminal — restart the agent in the cell you are looking at",
  "description": "Short feature clip. Changing an MCP server or the config leaves a running agent with the old view of the world; an opt-in header button restarts it in place — same cell, same directory, same conversation. Slides are English in both language versions.",
  "beats": [
    {
      "text": "Changed your MCP config? One button restarts the agent in place — and the conversation comes back.",
      "image": {
        "type": "html_tailwind",
        "animation": true,
        "html": [
          "<div class='w-full h-full bg-slate-950 relative'>",
          "  <div class='absolute top-6 left-10 text-sm tracking-[0.3em] uppercase text-slate-600'>Supervise</div>",
          "  <div class='absolute left-0 right-0 text-center text-5xl font-semibold text-slate-100' style='top:40px'>In-Cell Restart</div>",
          "  <div class='absolute' style='top:104px;left:200px;width:880px'>",
          "    <video src='./mt-restart-assets/clip.mp4' autoplay muted playsinline class='rounded-lg shadow-2xl' style='width:880px;display:block'></video>",
          "  </div>",
          "</div>"
        ]
      }
    },
    {
      "text": "It is opt-in — nothing appears until you write it in. One buttons entry in your config puts it in the header, or bind terminal-restart to a key.",
      "image": {
        "type": "html_tailwind",
        "html": [
          "<div class='w-full h-full bg-slate-950 relative'>",
          "  <div class='absolute top-6 left-10 text-sm tracking-[0.3em] uppercase text-slate-600'>Supervise</div>",
          "  <div class='absolute left-0 right-0 text-center text-5xl font-semibold text-slate-100' style='top:40px'>Opt-in — one entry in your config</div>",
          "  <div class='absolute flex flex-col gap-6' style='top:150px;left:180px;width:920px'>",
          "    <div class='rounded-xl border border-slate-700 bg-slate-900 p-6'>",
          "      <div class='text-slate-500 text-lg mb-3 font-mono'>~/.mulmoterminal/config.json — a header button</div>",
          "      <pre class='text-2xl font-mono text-slate-200 leading-relaxed'>\"buttons\": [",
          "  { \"id\": \"restart\", \"icon\": \"restart_alt\",",
          "    \"run\": \"action\", \"action\": \"restart\" }",
          "]</pre>",
          "    </div>",
          "    <div class='rounded-xl border border-slate-700 bg-slate-900 p-6'>",
          "      <div class='text-slate-500 text-lg mb-3 font-mono'>…or a keyboard shortcut</div>",
          "      <pre class='text-2xl font-mono text-slate-200 leading-relaxed'>\"keymap\": { \"terminal-restart\": \"Ctrl+Alt+R\" }</pre>",
          "    </div>",
          "  </div>",
          "</div>"
        ]
      }
    }
  ]
}