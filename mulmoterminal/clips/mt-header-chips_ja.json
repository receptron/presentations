{
  "$mulmocast": {
    "version": "1.1"
  },
  "canvasSize": {
    "width": 1280,
    "height": 720
  },
  "imageParams": {
    "provider": "openai",
    "images": {},
    "concurrency": 1
  },
  "audioParams": {
    "bgm": {
      "kind": "path",
      "path": "../../resources/bgms/morning001.mp3"
    },
    "padding": 0.3,
    "introPadding": 0.5,
    "closingPadding": 0.3,
    "outroPadding": 2.0,
    "bgmVolume": 0.12,
    "audioVolume": 1,
    "suppressSpeech": false,
    "concurrency": 1
  },
  "speechParams": {
    "speakers": {
      "Presenter": {
        "displayName": {
          "ja": "ナレーター"
        },
        "voiceId": "Kore",
        "isDefault": true,
        "provider": "gemini",
        "speechOptions": {
          "instruction": "落ち着いた、断定的な語り口。テンポよく、間を伸ばさない。"
        }
      }
    }
  },
  "captionParams": {
    "lang": "ja",
    "captionSplit": "estimate",
    "textSplit": {
      "type": "delimiters",
      "delimiters": [
        "。"
      ]
    },
    "bottomOffset": 4
  },
  "lang": "ja",
  "title": "MulmoTerminal — put your own chip on the header",
  "description": "Short feature clip. The cell header takes chips of your own beside the built-in ones; this one names the worktree the cell is in, so starting an issue from the list shows the tree it cut. Opt-in, and there is no Settings page for it. Slides are English in both language versions.",
  "beats": [
    {
      "text": "ヘッダーには自分のチップを足せます。これは worktree の名前です。",
      "image": {
        "type": "html_tailwind",
        "animation": true,
        "html": [
          "<div class='w-full h-full bg-slate-950 relative'>",
          "  <div class='absolute flex items-baseline justify-between' style='top:22px;left:40px;right:40px'><span><span class='text-xl font-semibold text-slate-200'>MulmoTerminal</span><span class='font-mono text-lg text-emerald-400 ml-5'>npx mulmoterminal@latest</span></span><span class='font-mono text-sm text-slate-500'>MIT · receptron.github.io/mulmoterminal</span></div>",
          "  <div class='absolute left-0 right-0 text-center text-5xl font-semibold text-slate-100' style='top:54px'>Header Chips</div>",
          "  <div class='absolute' style='top:104px;left:200px;width:880px'>",
          "    <video src='./mt-header-chips-assets/chip.mp4' autoplay muted playsinline class='rounded-lg shadow-2xl' style='width:880px;display:block'></video>",
          "  </div>",
          "</div>"
        ]
      },
      "duration": 5.0
    },
    {
      "text": "一覧から issue を始めると、切られた worktree がそのまま出ます。",
      "image": {
        "type": "html_tailwind",
        "animation": true,
        "html": [
          "<div class='w-full h-full bg-slate-950 relative'>",
          "  <div class='absolute flex items-baseline justify-between' style='top:22px;left:40px;right:40px'><span><span class='text-xl font-semibold text-slate-200'>MulmoTerminal</span><span class='font-mono text-lg text-emerald-400 ml-5'>npx mulmoterminal@latest</span></span><span class='font-mono text-sm text-slate-500'>MIT · receptron.github.io/mulmoterminal</span></div>",
          "  <div class='absolute left-0 right-0 text-center text-5xl font-semibold text-slate-100' style='top:54px'>Header Chips</div>",
          "  <div class='absolute' style='top:104px;left:200px;width:880px'>",
          "    <video src='./mt-header-chips-assets/flow.mp4' autoplay muted playsinline class='rounded-lg shadow-2xl' style='width:880px;display:block'></video>",
          "  </div>",
          "</div>"
        ]
      },
      "duration": 7.5
    },
    {
      "text": "チップは Settings に画面がありません。設定ファイルに書きます。",
      "image": {
        "type": "html_tailwind",
        "html": [
          "<div class='w-full h-full bg-slate-950 relative'>",
          "  <div class='absolute flex items-baseline justify-between' style='top:22px;left:40px;right:40px'><span><span class='text-xl font-semibold text-slate-200'>MulmoTerminal</span><span class='font-mono text-lg text-emerald-400 ml-5'>npx mulmoterminal@latest</span></span><span class='font-mono text-sm text-slate-500'>MIT · receptron.github.io/mulmoterminal</span></div>",
          "  <div class='absolute left-0 right-0 text-center text-5xl font-semibold text-slate-100' style='top:54px'>Header Chips</div>",
          "  <div class='absolute rounded-lg bg-slate-900 border border-slate-700 font-mono text-2xl text-slate-200 leading-relaxed' style='top:180px;left:120px;right:120px;padding:36px 44px'>",
          "    <div><span class='text-slate-500'>~/.mulmoterminal/config.json</span></div><div>{ <span class='text-sky-300'>\"chips\"</span>: [<span class='text-emerald-300'>\"git\"</span>, <span class='text-emerald-300'>\"ctx\"</span>, <span class='text-emerald-300'>\"diff\"</span>, <span class='text-emerald-300'>\"usage\"</span>,</div><div>    { <span class='text-sky-300'>\"label\"</span>: <span class='text-emerald-300'>\"Which worktree this cell is on\"</span>,</div><div>      <span class='text-sky-300'>\"text\"</span>: <span class='text-emerald-300'>\"${task}\"</span>, <span class='text-sky-300'>\"when\"</span>: <span class='text-emerald-300'>\"task != \"</span> }] }</div>",
          "  </div>",
          "</div>"
        ]
      },
      "duration": 4.8
    },
    {
      "text": "",
      "duration": 1.0,
      "image": {
        "type": "html_tailwind",
        "html": [
          "<div class='w-full h-full bg-black flex flex-col items-center justify-center gap-6'>",
          "  <div class='font-mono text-4xl text-emerald-400'>npx mulmoterminal@latest</div>",
          "  <div class='font-mono text-lg text-slate-500'>MIT · receptron.github.io/mulmoterminal</div>",
          "</div>"
        ]
      }
    }
  ]
}
