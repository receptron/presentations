{
  "$mulmocast": {
    "version": "1.1"
  },
  "canvasSize": {
    "width": 1280,
    "height": 720
  },
  "imageParams": {
    "provider": "openai",
    "images": {},
    "concurrency": 1
  },
  "audioParams": {
    "bgm": {
      "kind": "path",
      "path": "../../resources/bgms/morning001.mp3"
    },
    "padding": 0.3,
    "introPadding": 0.5,
    "closingPadding": 0.3,
    "outroPadding": 2.0,
    "bgmVolume": 0.12,
    "audioVolume": 1,
    "suppressSpeech": false,
    "concurrency": 1
  },
  "speechParams": {
    "speakers": {
      "Presenter": {
        "displayName": {
          "ja": "ナレーター"
        },
        "voiceId": "Kore",
        "isDefault": true,
        "provider": "gemini",
        "speechOptions": {
          "instruction": "落ち着いた、断定的な語り口。テンポよく、間を伸ばさない。"
        }
      }
    }
  },
  "captionParams": {
    "lang": "ja",
    "captionSplit": "estimate",
    "textSplit": {
      "type": "delimiters",
      "delimiters": [
        ". "
      ]
    },
    "bottomOffset": 4
  },
  "lang": "ja",
  "title": "MulmoTerminal — open a deck from any repository",
  "description": "Short feature clip. A mulmoScript deck kept inside a repository opens in the Canvas straight from the file tree, and stays that repository's own file. Slides are English in both language versions.",
  "beats": [
    {
      "text": "どのリポジトリの中のデッキも、その場所のまま開けます。",
      "image": {
        "type": "html_tailwind",
        "animation": true,
        "html": [
          "<div class='w-full h-full bg-slate-950 relative'>",
          "  <div class='absolute flex items-baseline justify-between' style='top:22px;left:40px;right:40px'><span><span class='text-xl font-semibold text-slate-200'>MulmoTerminal</span><span class='font-mono text-lg text-emerald-400 ml-5'>npx mulmoterminal@latest</span></span><span class='font-mono text-sm text-slate-500'>MIT · receptron.github.io/mulmoterminal</span></div>",
          "  <div class='absolute left-0 right-0 text-center text-5xl font-semibold text-slate-100' style='top:54px'>Decks Anywhere</div>",
          "  <div class='absolute' style='top:104px;left:200px;width:880px'>",
          "    <video src='./mt-decks-anywhere-assets/open.mp4' autoplay muted playsinline class='rounded-lg shadow-2xl' style='width:880px;display:block'></video>",
          "  </div>",
          "</div>"
        ]
      },
      "duration": 4.6
    },
    {
      "text": "Canvas にスライドが出ます。ファイルは元の場所のままです。",
      "image": {
        "type": "html_tailwind",
        "animation": true,
        "html": [
          "<div class='w-full h-full bg-slate-950 relative'>",
          "  <div class='absolute flex items-baseline justify-between' style='top:22px;left:40px;right:40px'><span><span class='text-xl font-semibold text-slate-200'>MulmoTerminal</span><span class='font-mono text-lg text-emerald-400 ml-5'>npx mulmoterminal@latest</span></span><span class='font-mono text-sm text-slate-500'>MIT · receptron.github.io/mulmoterminal</span></div>",
          "  <div class='absolute left-0 right-0 text-center text-5xl font-semibold text-slate-100' style='top:54px'>Decks Anywhere</div>",
          "  <div class='absolute' style='top:104px;left:200px;width:880px'>",
          "    <video src='./mt-decks-anywhere-assets/canvas.mp4' autoplay muted playsinline class='rounded-lg shadow-2xl' style='width:880px;display:block'></video>",
          "  </div>",
          "</div>"
        ]
      },
      "duration": 4.6
    },
    {
      "text": "",
      "duration": 1.0,
      "image": {
        "type": "html_tailwind",
        "html": [
          "<div class='w-full h-full bg-black flex flex-col items-center justify-center gap-6'>",
          "  <div class='font-mono text-4xl text-emerald-400'>npx mulmoterminal@latest</div>",
          "  <div class='font-mono text-lg text-slate-500'>MIT · receptron.github.io/mulmoterminal</div>",
          "</div>"
        ]
      }
    }
  ]
}
