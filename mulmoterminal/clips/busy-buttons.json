{
  "$mulmocast": {
    "version": "1.1"
  },
  "canvasSize": {
    "width": 1280,
    "height": 720
  },
  "speechParams": {
    "speakers": {
      "Presenter": {
        "displayName": {
          "en": "Presenter"
        },
        "voiceId": "Kore",
        "isDefault": true,
        "provider": "gemini",
        "speechOptions": {
          "instruction": "Calm, confident, measured — short declarative sentences, like a good product keynote. No exclamation marks in delivery, no salesy energy. Let the pauses between sentences breathe."
        }
      }
    }
  },
  "imageParams": {
    "provider": "openai",
    "images": {}
  },
  "audioParams": {
    "bgm": {
      "kind": "path",
      "path": "../../resources/bgms/morning001.mp3"
    },
    "padding": 0.3,
    "introPadding": 0.5,
    "closingPadding": 0.3,
    "outroPadding": 0,
    "bgmVolume": 0.12,
    "audioVolume": 1,
    "suppressSpeech": false,
    "concurrency": 1
  },
  "captionParams": {
    "lang": "en",
    "captionSplit": "estimate",
    "textSplit": {
      "type": "delimiters",
      "delimiters": [
        ". "
      ]
    },
    "bottomOffset": 4
  },
  "lang": "en",
  "title": "MulmoTerminal 4.7.3 — buttons that say they are working",
  "description": "Short feature clip (~15s) for MulmoTerminal 4.7.3. A worktree button that took six seconds and showed nothing got pressed again, making one worktree per click; it now locks itself and reports progress, and a cell being removed looks like it. Slides are English in both language versions — see busy-buttons-NOTES.md.",
  "beats": [
    {
      "text": "Name a task, press once — and the button locks itself and says what it is doing.",
      "image": {
        "type": "html_tailwind",
        "animation": {
          "movie": true
        },
        "html": [
          "<div class='w-full h-full bg-slate-950 relative'>",
          "  <div class='absolute top-8 left-10 text-base tracking-[0.3em] uppercase text-slate-600'>MulmoTerminal 4.7.3</div>",
          "  <div class='absolute left-0 right-0 text-center text-5xl font-semibold text-slate-100' style='top:84px'>The button says what it&rsquo;s doing.</div>",
          "  <div class='absolute' style='top:180px;left:110px;width:1060px'>",
          "    <video src='./busy-buttons-assets/01-press-once.mp4' autoplay muted playsinline class='rounded-xl shadow-2xl' style='width:1060px;display:block'></video>",
          "  </div>",
          "</div>"
        ]
      }
    },
    {
      "text": "You close it from the cell's own close button.",
      "image": {
        "type": "html_tailwind",
        "animation": {
          "movie": true
        },
        "html": [
          "<div class='w-full h-full bg-slate-950 relative'>",
          "  <div class='absolute top-8 left-10 text-base tracking-[0.3em] uppercase text-slate-600'>MulmoTerminal 4.7.3</div>",
          "  <div class='absolute left-0 right-0 text-center text-5xl font-semibold text-slate-100' style='top:84px'>Closing starts here.</div>",
          "  <div class='absolute' style='top:180px;left:110px;width:1060px'>",
          "    <video src='./busy-buttons-assets/02-close-button.mp4' autoplay muted playsinline class='rounded-xl shadow-2xl' style='width:1060px;display:block'></video>",
          "    <div class='absolute rounded-md ring-4 ring-indigo-400' style='left:95.2%;top:3.4%;width:3.0%;height:6.4%'></div>",
          "  </div>",
          "</div>"
        ]
      }
    },
    {
      "text": "Because it is a worktree, it asks first.",
      "image": {
        "type": "html_tailwind",
        "animation": {
          "movie": true
        },
        "html": [
          "<div class='w-full h-full bg-slate-950 relative'>",
          "  <div class='absolute top-8 left-10 text-base tracking-[0.3em] uppercase text-slate-600'>MulmoTerminal 4.7.3</div>",
          "  <div class='absolute left-0 right-0 text-center text-5xl font-semibold text-slate-100' style='top:84px'>It asks before it removes.</div>",
          "  <div class='absolute' style='top:180px;left:110px;width:1060px'>",
          "    <video src='./busy-buttons-assets/03-it-asks.mp4' autoplay muted playsinline class='rounded-xl shadow-2xl' style='width:1060px;display:block'></video>",
          "    <div class='absolute rounded-md ring-4 ring-indigo-400' style='left:46.6%;top:47.6%;width:15.0%;height:11.0%'></div>",
          "  </div>",
          "</div>"
        ]
      }
    },
    {
      "text": "Choose remove, and the whole cell dims, says what it is removing, and goes.",
      "image": {
        "type": "html_tailwind",
        "animation": {
          "movie": true
        },
        "html": [
          "<div class='w-full h-full bg-slate-950 relative'>",
          "  <div class='absolute top-8 left-10 text-base tracking-[0.3em] uppercase text-slate-600'>MulmoTerminal 4.7.3</div>",
          "  <div class='absolute left-0 right-0 text-center text-5xl font-semibold text-slate-100' style='top:84px'>Then it says what it&rsquo;s removing.</div>",
          "  <div class='absolute' style='top:180px;left:110px;width:1060px'>",
          "    <video src='./busy-buttons-assets/04-removing.mp4' autoplay muted playsinline class='rounded-xl shadow-2xl' style='width:1060px;display:block'></video>",
          "  </div>",
          "</div>"
        ]
      }
    }
  ]
}
