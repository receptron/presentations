{
  "$mulmocast": {
    "version": "1.1"
  },
  "canvasSize": {
    "width": 1280,
    "height": 720
  },
  "speechParams": {
    "speakers": {
      "Presenter": {
        "displayName": {
          "en": "Presenter"
        },
        "voiceId": "Kore",
        "isDefault": true,
        "provider": "gemini",
        "speechOptions": {
          "instruction": "Calm, confident, measured — short declarative sentences, like a good product keynote. No exclamation marks in delivery, no salesy energy. Let the pauses between sentences breathe."
        }
      }
    }
  },
  "imageParams": {
    "provider": "openai",
    "images": {}
  },
  "audioParams": {
    "bgm": {
      "kind": "path",
      "path": "../../resources/bgms/morning001.mp3"
    },
    "padding": 0.3,
    "introPadding": 0.5,
    "closingPadding": 0.3,
    "outroPadding": 2.5,
    "bgmVolume": 0.12,
    "audioVolume": 1,
    "suppressSpeech": false,
    "concurrency": 1
  },
  "captionParams": {
    "lang": "en",
    "captionSplit": "estimate",
    "textSplit": {
      "type": "delimiters",
      "delimiters": [
        ". "
      ]
    },
    "bottomOffset": 4
  },
  "lang": "en",
  "title": "MulmoTerminal 4.7.5 — what you can change, and where it lives",
  "description": "Short feature clip for MulmoTerminal 4.7.5. Where the settings live and what is in them: one gear in the toolbar, nine groups, one section at a time, and the whole panel in Japanese if you want it. Slides are English in both language versions — see 4.7.5-clips-NOTES.md.",
  "beats": [
    {
      "text": "Everything you can change about MulmoTerminal is behind one gear in the toolbar.",
      "image": {
        "type": "html_tailwind",
        "animation": {
          "movie": true
        },
        "html": [
          "<div class='w-full h-full bg-slate-950 relative'>",
          "  <div class='absolute top-8 left-10 text-base tracking-[0.3em] uppercase text-slate-600'>MulmoTerminal 4.7.5</div>",
          "  <div class='absolute left-0 right-0 text-center text-5xl font-semibold text-slate-100' style='top:84px'>It all lives behind the gear.</div>",
          "  <div class='absolute' style='top:180px;left:110px;width:1060px'>",
          "    <video src='./settings-you-can-find-assets/00-where-it-lives.mp4' autoplay muted playsinline class='rounded-xl shadow-2xl' style='width:1060px;display:block'></video>",
          "  </div>",
          "</div>"
        ]
      }
    },
    {
      "text": "Nine groups of settings: how it looks, your projects, input, models, notifications, integrations, sessions.",
      "image": {
        "type": "html_tailwind",
        "animation": {
          "movie": true
        },
        "html": [
          "<div class='w-full h-full bg-slate-950 relative'>",
          "  <div class='absolute top-8 left-10 text-base tracking-[0.3em] uppercase text-slate-600'>MulmoTerminal 4.7.5</div>",
          "  <div class='absolute left-0 right-0 text-center text-5xl font-semibold text-slate-100' style='top:84px'>Nine groups of settings.</div>",
          "  <div class='absolute' style='top:180px;left:110px;width:1060px'>",
          "    <video src='./settings-you-can-find-assets/01-nine-groups.mp4' autoplay muted playsinline class='rounded-xl shadow-2xl' style='width:1060px;display:block'></video>",
          "  </div>",
          "</div>"
        ]
      }
    },
    {
      "text": "Pick a group and the whole section is right there — every sound, and what each one is for.",
      "image": {
        "type": "html_tailwind",
        "animation": {
          "movie": true
        },
        "html": [
          "<div class='w-full h-full bg-slate-950 relative'>",
          "  <div class='absolute top-8 left-10 text-base tracking-[0.3em] uppercase text-slate-600'>MulmoTerminal 4.7.5</div>",
          "  <div class='absolute left-0 right-0 text-center text-5xl font-semibold text-slate-100' style='top:84px'>Pick a group, get the whole section.</div>",
          "  <div class='absolute' style='top:180px;left:110px;width:1060px'>",
          "    <video src='./settings-you-can-find-assets/02-one-section.mp4' autoplay muted playsinline class='rounded-xl shadow-2xl' style='width:1060px;display:block'></video>",
          "  </div>",
          "</div>"
        ]
      }
    },
    {
      "text": "And the whole screen reads in Japanese the moment you choose it.",
      "image": {
        "type": "html_tailwind",
        "animation": {
          "movie": true
        },
        "html": [
          "<div class='w-full h-full bg-slate-950 relative'>",
          "  <div class='absolute top-8 left-10 text-base tracking-[0.3em] uppercase text-slate-600'>MulmoTerminal 4.7.5</div>",
          "  <div class='absolute left-0 right-0 text-center text-5xl font-semibold text-slate-100' style='top:84px'>Or read it in Japanese.</div>",
          "  <div class='absolute' style='top:180px;left:110px;width:1060px'>",
          "    <video src='./settings-you-can-find-assets/03-japanese.mp4' autoplay muted playsinline class='rounded-xl shadow-2xl' style='width:1060px;display:block'></video>",
          "  </div>",
          "</div>"
        ]
      }
    }
  ]
}
